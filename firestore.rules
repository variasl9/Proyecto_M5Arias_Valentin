rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidProduct(p) {
      return p.name is string && p.name.size() > 0
        && p.nameLower == p.name.lower()
        && p.description is string
        && p.price is number && p.price > 0
        && p.stock is int && p.stock >= 0
        && p.category is string && p.category.size() > 0
        && p.imageUrl is string;
    }

    // Un cliente solo puede BAJAR el stock (al comprar), nunca subirlo ni tocar otro campo
    function isStockDecrement() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }

    function isValidNewOrder(o) {
      return o.userId == request.auth.uid
        && o.userEmail is string
        && o.status == 'pending'
        && o.items is list && o.items.size() > 0 && o.items.size() <= 50
        && o.total is number && o.total > 0
        && o.shipping is map
        && o.payment is map && o.payment.status == 'approved'
        && o.createdAt == request.time;
    }

    function isValidTransition(from, to) {
      return (from == 'pending' && to in ['processing', 'cancelled'])
        || (from == 'processing' && to in ['completed', 'cancelled']);
    }

    // ---------- Perfiles de usuario ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'customer';
      allow update: if isOwner(uid) && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // ---------- Productos ----------
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(request.resource.data);
      allow update: if (isAdmin() && isValidProduct(request.resource.data)) || isStockDecrement();
      allow delete: if isAdmin();
    }

    // ---------- Carritos ----------
    match /carts/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
    }

    // ---------- Órdenes ----------
    match /orders/{orderId} {
      // El dueño ve sus órdenes; el admin ve todas
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      // Solo se crean a nombre propio, en estado 'pending' y con pago aprobado
      allow create: if isSignedIn() && isValidNewOrder(request.resource.data);
      // Solo el admin cambia el estado, y siguiendo el flujo permitido
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && isValidTransition(resource.data.status, request.resource.data.status);
      // Las órdenes son un registro contable: nunca se borran
      allow delete: if false;
    }
  }
}